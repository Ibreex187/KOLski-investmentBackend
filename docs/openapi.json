{
  "openapi": "3.0.3",
  "info": {
    "title": "Investment App API",
    "version": "1.0.0",
    "description": "Backend API documentation for authentication, portfolio analytics, reporting, and admin/security endpoints."
  },
  "servers": [
    {
      "url": "http://localhost:4040",
      "description": "Local development server"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "summary": "Health check",
        "responses": {
          "200": {
            "description": "Service is healthy"
          }
        }
      }
    },
    "/api/v1/login": {
      "post": {
        "summary": "Authenticate a user",
        "responses": {
          "200": { "description": "Login successful" },
          "403": { "description": "Email not verified" }
        }
      }
    },
    "/api/v1/portfolio/buy": {
      "post": {
        "summary": "Buy shares at the current market price",
        "description": "The execution price is decided by the server from live market data. Any price sent in the request body is ignored. Send an idempotency key (x-idempotency-key header or reference_id) so retries are safe; a repeated key returns the original result with duplicate: true.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "x-idempotency-key",
            "in": "header",
            "schema": {
              "type": "string"
            },
            "description": "Makes retries safe. Also accepted as reference_id in the body."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "symbol",
                  "shares"
                ],
                "properties": {
                  "symbol": {
                    "type": "string",
                    "example": "AAPL"
                  },
                  "shares": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "description": "Up to 6 decimal places.",
                    "example": 2
                  },
                  "name": {
                    "type": "string",
                    "description": "Company name (used when a holding is first created)."
                  },
                  "sector": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Order filled (or a duplicate of an earlier order). Response includes symbol, shares, price, total, price_source (live|demo), newBalance, transaction_id."
          },
          "400": {
            "description": "Invalid order, insufficient funds, or order value too small"
          },
          "401": {
            "description": "Not authenticated"
          },
          "404": {
            "description": "Portfolio not found"
          },
          "503": {
            "description": "Market data unavailable (error.code = MARKET_DATA_UNAVAILABLE). The order is not placed; retry later."
          }
        }
      }
    },
    "/api/v1/portfolio/sell": {
      "post": {
        "summary": "Sell shares at the current market price",
        "description": "The execution price is decided by the server from live market data. Any price sent in the request body is ignored. Send an idempotency key (x-idempotency-key header or reference_id) so retries are safe; a repeated key returns the original result with duplicate: true.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "x-idempotency-key",
            "in": "header",
            "schema": {
              "type": "string"
            },
            "description": "Makes retries safe. Also accepted as reference_id in the body."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "symbol",
                  "shares"
                ],
                "properties": {
                  "symbol": {
                    "type": "string",
                    "example": "AAPL"
                  },
                  "shares": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "description": "Up to 6 decimal places.",
                    "example": 2
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Order filled (or a duplicate of an earlier order). Response includes symbol, shares, price, total, price_source (live|demo), newBalance, transaction_id, realized_pnl."
          },
          "400": {
            "description": "Invalid order, not enough shares, or order value too small"
          },
          "401": {
            "description": "Not authenticated"
          },
          "404": {
            "description": "Portfolio not found"
          },
          "503": {
            "description": "Market data unavailable (error.code = MARKET_DATA_UNAVAILABLE). The order is not placed; retry later."
          }
        }
      }
    },
    "/api/v1/demo/login": {
      "post": {
        "summary": "Log in to the shared public demo account",
        "description": "No credentials required. Logs the caller into a single shared, seeded demo portfolio (fake data, no real money), issuing a normal token/refreshToken pair. Rate limited per IP.",
        "responses": {
          "200": {
            "description": "Session created. Response includes token, refreshToken, and user (user.isDemo is true)."
          },
          "429": {
            "description": "Too many demo login attempts from this client"
          }
        }
      }
    },
    "/api/v1/portfolio/dashboard": {
      "get": {
        "summary": "Get frontend-ready dashboard payload",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Dashboard analytics payload" }
        }
      }
    },
    "/api/v1/portfolio/transactions": {
      "get": {
        "summary": "List and filter transactions",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "type", "in": "query", "schema": { "type": "string" } },
          { "name": "symbol", "in": "query", "schema": { "type": "string" } },
          { "name": "startDate", "in": "query", "schema": { "type": "string", "format": "date" } },
          { "name": "endDate", "in": "query", "schema": { "type": "string", "format": "date" } },
          { "name": "page", "in": "query", "schema": { "type": "integer" } },
          { "name": "limit", "in": "query", "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": { "description": "Filtered transaction report" }
        }
      }
    },
    "/api/v1/portfolio/transactions/export": {
      "get": {
        "summary": "Export transactions as CSV",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "format", "in": "query", "schema": { "type": "string", "enum": ["csv"] } }
