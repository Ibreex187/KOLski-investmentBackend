PORT=4080
NODE_ENV=development
DATABASE_URI=mongodb://127.0.0.1:27017/investmentapp
# REQUIRED: the server refuses to start without JWT_SECRET, and in production it also
# rejects placeholder values. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too
JWT_EXPIRES_IN=5h
JWT_REFRESH_EXPIRES_IN=7d
REFRESH_TOKEN_TTL_MS=604800000
EMAIL_VERIFICATION_TOKEN_TTL_HOURS=24
CLIENT_BASE_URL=http://localhost:3000
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=10
VERIFICATION_RATE_LIMIT_WINDOW_MS=900000
VERIFICATION_RATE_LIMIT_MAX=5
FORGOT_PASSWORD_RATE_LIMIT_WINDOW_MS=900000
FORGOT_PASSWORD_RATE_LIMIT_MAX=5
REFRESH_RATE_LIMIT_WINDOW_MS=600000
REFRESH_RATE_LIMIT_MAX=20
ALPHA_VANTAGE_KEY=your-alpha-vantage-key
# Without a key (or when the provider is down/rate limited) market and trade endpoints
# answer 503 instead of inventing prices. Set to true ONLY for demos: it serves fixed,
# clearly labelled (source: "demo") data.
ALLOW_DEMO_MARKET_DATA=false

OTP_EXPIRY_MINUTES=10
OTP_REQUEST_WINDOW_MINUTES=15
OTP_MAX_REQUESTS_PER_WINDOW=3
OTP_MIN_RESEND_SECONDS=60
FORGOT_PASSWORD_RESET_TOKEN_TTL_MINUTES=15

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=no-reply@example.com
SUPPORT_EMAIL=support@example.com
# Scheduled jobs (price alerts on Vercel). The endpoint /api/v1/internal/cron/check-alerts is
# disabled (503) unless CRON_SECRET is set; callers must send `Authorization: Bearer <secret>`.
# Vercel Cron sends it automatically. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=
# Symbols checked per run and notification retries. The free market API allows only ~25 calls/day,
# shared with all user quotes and trades, so keep this small.
ALERT_MAX_SYMBOLS_PER_RUN=2
ALERT_MAX_NOTIFY_ATTEMPTS=3

# Public demo account (shared login, no password, reset nightly by the reset-demo cron).
DEMO_ACCOUNT_EMAIL=demo@kolski.app
DEMO_ACCOUNT_USERNAME=demo_investor
DEMO_LOGIN_RATE_LIMIT_WINDOW_MS=900000
DEMO_LOGIN_RATE_LIMIT_MAX=30
