{
  "version": 2,
  "functions": {
    "api/index.js": {
      "maxDuration": 10
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ],
  "crons": [
    {
      "path": "/api/v1/internal/cron/check-alerts",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/v1/internal/cron/reset-demo",
      "schedule": "0 6 * * *"
    }
  ]
}
